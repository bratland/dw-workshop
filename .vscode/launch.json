{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "node",
			"request": "launch",
			"name": "SvelteKit: dev",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "dev"],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"skipFiles": ["<node_internals>/**"]
		},
		{
			"type": "node",
			"request": "launch",
			"name": "SvelteKit: build",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "build"],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"skipFiles": ["<node_internals>/**"]
		},
		{
			"type": "node",
			"request": "launch",
			"name": "SvelteKit: preview",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "preview"],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"skipFiles": ["<node_internals>/**"]
		},
		{
			"type": "chrome",
			"request": "launch",
			"name": "Chrome: localhost:5173",
			"url": "http://localhost:5173",
			"webRoot": "${workspaceFolder}/src",
			"sourceMaps": true
		}
	],
	"compounds": [
		{
			"name": "Dev + Chrome",
			"configurations": ["SvelteKit: dev", "Chrome: localhost:5173"],
			"stopAll": true
		}
	]
}
